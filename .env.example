# Production (Vercel + Supabase PostgreSQL + Supabase Storage)
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
# Copy the exact Transaction pooler URI from Supabase Project -> Connect (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@POOLER-HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-Supabase-secret-key
SUPABASE_STORAGE_BUCKET=payment-slips
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional host overrides (comma-separated). Defaults match the three Vercel domains.
# STUDENT_PORTAL_HOSTS=sliit-parking-beta.vercel.app
# ADMIN_PORTAL_HOSTS=sliit-parking-admin.vercel.app
# ENFORCER_PORTAL_HOSTS=sliit-parking-enforcer.vercel.app

# Local development: omit DATABASE_URL to use SQLite in ./sliit-parking.db.
# SQLITE_PATH=./sliit-parking.db
# ADMIN_PASSWORD=change-this-local-admin-password
# JWT_SECRET=replace-with-a-long-random-local-secret
