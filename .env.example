# Server-only settings. Never prefix these with VITE_ or NEXT_PUBLIC_.
NODE_ENV=development
PORT=3000

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Supabase project URL (safe to expose only if used in server-side code here)
SUPABASE_URL=https://pkcqeqplgslmgxdmvqti.supabase.co
# Supabase service_role/secret key. Keep this server-side; never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string. Use the Transaction Pooler for Vercel.
# Copy the URI from Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Do not commit the password. For transaction pooling, follow Supabase's current connection guidance.
DATABASE_URL=

# Used only when bootstrapping the first admin account.
ADMIN_PASSWORD=
